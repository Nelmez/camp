<?php
// CAMP-WELCOME
$campFile = '{{CONF}}/camp-web.php';
$phpVersion = PHP_VERSION;
$database = 'MariaDB is not configured yet.';
if (is_file($campFile)) {
    $camp = require $campFile;
    $mysqli = @new mysqli($camp['host'], $camp['user'], $camp['password'], '', (int) $camp['port']);
    if ($mysqli->connect_errno) {
        $database = 'MariaDB refused the connection.';
    } else {
        $database = 'MariaDB accepted the connection.';
        $mysqli->close();
    }
}
?>
