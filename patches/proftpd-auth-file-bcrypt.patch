--- a/modules/mod_auth_file.c
+++ b/modules/mod_auth_file.c
@@ -1576,2 +1576,15 @@ MODRET authfile_chkpass(cmd_rec *cmd) {
-  crypted_pass = crypt(cleartxt_pass, ciphertxt_pass);
-  xerrno = errno;
+  if (strncmp(ciphertxt_pass, "$2", 2) == 0) {
+    size_t hashed_len = 0;
+
+    /* ProFTPD's bundled bcrypt implementation supports the $2y$ hashes
+     * generated by Apache htpasswd, including on macOS where crypt(3)
+     * only provides the legacy DES format.
+     */
+    crypted_pass = pr_auth_bcrypt(cmd->tmp_pool, cleartxt_pass,
+      ciphertxt_pass, &hashed_len);
+    xerrno = errno;
+  } else {
+    /* Keep existing AuthUserFile entries working during upgrades. */
+    crypted_pass = crypt(cleartxt_pass, ciphertxt_pass);
+    xerrno = errno;
+  }
